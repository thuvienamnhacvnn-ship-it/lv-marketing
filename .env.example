# ─────────────────────────────────────────────────────────────
# LV MARKETING HUB — mẫu biến môi trường
# Sao chép thành `.env` rồi điền giá trị thật. KHÔNG commit file .env.
# ─────────────────────────────────────────────────────────────

# PostgreSQL — dùng Neon, Supabase, hoặc docker-compose kèm theo repo
DATABASE_URL="postgresql://lv_user:lv_password@localhost:5432/lv_marketing_hub?schema=public"

# Auth.js — sinh chuỗi ngẫu nhiên: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Anthropic Claude — bắt buộc để bật các tính năng AI.
# Nếu để trống, ứng dụng vẫn chạy nhưng mọi nút AI sẽ báo "chưa cấu hình" thay vì giả lập kết quả.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
ANTHROPIC_MAX_TOKENS="2048"
AI_TIMEOUT_MS="60000"
AI_MAX_RETRIES="2"

# Bảo vệ endpoint cron đăng bài theo lịch (/api/cron/publish-due)
CRON_SECRET=""

# Lưu trữ tệp: local | cloudinary | uploadthing
UPLOAD_DRIVER="local"
CLOUDINARY_URL=""
UPLOADTHING_TOKEN=""
