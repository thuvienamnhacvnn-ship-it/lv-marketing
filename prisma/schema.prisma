model Review {
  id             String       @id @default(cuid())
  organizationId String
  branchId       String?
  customerId     String?
  source         ReviewSource @default(GOOGLE)
  externalId     String?
  authorName     String
  rating         Int
  body           String?
  language       String       @default("de")
  sentiment      Sentiment    @default(NEUTRAL)
  sentimentScore Float?
  topics         String[]
  postedAt       DateTime
  isDemo         Boolean      @default(false)
