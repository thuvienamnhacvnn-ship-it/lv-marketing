  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([reviewId])
}

// ────────────────────────────────────────────────────────────
// AUTOMATION / LOYALTY
// ────────────────────────────────────────────────────────────

model Automation {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  trigger        AutomationTrigger
  triggerConfig  Json?
  status         AutomationStatus  @default(DRAFT)
  requireConsent Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        AutomationStep[]
  runs         AutomationRun[]

  @@index([organizationId, status])
}

model AutomationStep {
  id           String               @id @default(cuid())
  automationId String
  position     Int
  action       AutomationActionType
  config       Json?
  delayMinutes Int                  @default(0)

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, position])
}

model AutomationRun {
  id           String              @id @default(cuid())
  automationId String
  customerId   String?
  status       AutomationRunStatus @default(QUEUED)
  isTest       Boolean             @default(false)
  log          Json?
  error        String?
  startedAt    DateTime            @default(now())
  finishedAt   DateTime?

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([automationId, startedAt])
}

// ────────────────────────────────────────────────────────────
// LOYALTY
//
// Cấu trúc lấy theo PTC-Loyalty (ptc-bonus.com) để dữ liệu chuyển sang không
// mất mát. Hai chỗ khác hẳn bản LV cũ:
//
// 1. Voucher tách làm hai. `Voucher` là MẪU do chủ quán tạo (có hạn mức phát,
//    số điểm đổi, giới hạn mỗi khách). `IssuedVoucher` là bản đã phát cho một
//    khách cụ thể, mỗi bản một mã riêng. Gộp làm một như trước thì không biết
//    một mẫu đã phát bao nhiêu lần và ai còn hạn dùng.
//
// 2. Điểm có SỔ CÁI (`PointTransaction`) chứ không chỉ một con số dư. Không có
//    sổ thì không đối chiếu được khi khách khiếu nại, không hoàn tác được giao
//    dịch nhập sai, và không tính được điểm hết hạn.
// ────────────────────────────────────────────────────────────

model LoyaltyProgram {
  id             String             @id @default(cuid())
  organizationId String
  /// null = áp dụng cho mọi chi nhánh
  branchId       String?
  name           String
  type           LoyaltyProgramType @default(SPEND_BASED)
  isActive       Boolean            @default(true)
  /// Cấu hình riêng theo loại: số tem cần, tỉ lệ quy đổi, mua X tặng Y…
  config         Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  rules        LoyaltyRule[]

  @@index([organizationId, isActive])
}

model LoyaltyRule {
  id        String   @id @default(cuid())
  programId String
  name      String
  /// signup | birthday | referral | product | double_points | time_window
  kind      String
  value     Int      @default(0)
  config    Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  program LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
}

model MembershipTier {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  /// Thứ tự hạng: 1 thấp nhất. Dùng để so sánh, không dựa vào tên.
  level            Int
  /// Ngưỡng điểm TÍCH LUỸ TRỌN ĐỜI để đạt hạng, không phải điểm dư hiện tại.
  minPoints        Int      @default(0)
  pointsMultiplier Float    @default(1.0)
  color            String   @default("#a16207")
  perks            String?
  retentionDays    Int?
  createdAt        DateTime @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  CustomerMembership[]

  @@unique([organizationId, level])
  @@index([organizationId])
}

model CustomerMembership {
  id             String           @id @default(cuid())
  organizationId String
  customerId     String           @unique
  tierId         String
  status         MembershipStatus @default(ACTIVE)
  since          DateTime         @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tier         MembershipTier @relation(fields: [tierId], references: [id])

  @@index([organizationId])
}

model LoyaltyAccount {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String   @unique
  memberCode     String
  /// Bí mật riêng của từng thẻ, dùng ký mã QR. Đổi được khi khách mất thẻ.
  qrSecret       String   @default(cuid())
  points         Int      @default(0)
  totalEarned    Int      @default(0)
  totalRedeemed  Int      @default(0)
  isBlocked      Boolean  @default(false)
  referredBy     String?
  joinedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([organizationId, memberCode])
}

model PointTransaction {
  id              String                 @id @default(cuid())
  organizationId  String
  branchId        String?
  customerId      String
  /// Nhân viên thực hiện. Giữ lại cả khi họ nghỉ việc nên dùng SetNull.
  staffId         String?
  type            PointTransactionType
  status          PointTransactionStatus @default(COMPLETED)
  /// Số tiền hoá đơn, đơn vị xu. Chỉ có ở giao dịch tích điểm.
  amountCents     Int?
  /// Có dấu: dương khi cộng, âm khi trừ.
  points          Int
  balanceBefore   Int
  balanceAfter    Int
  issuedVoucherId String?
  /// Chặn bấm hai lần từ máy tính tiền.
  idempotencyKey  String?
  /// Mã hoá đơn — mỗi hoá đơn chỉ được tích điểm một lần.
  receiptRef      String?
  note            String?
  device          String?
  createdAt       DateTime               @default(now())

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?                      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer     Customer                     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff        User?                        @relation("PointTransactionStaff", fields: [staffId], references: [id], onDelete: SetNull)
  adjustments  PointTransactionAdjustment[]

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, receiptRef])
  @@index([organizationId, createdAt])
  @@index([organizationId, customerId])
}

model PointTransactionAdjustment {
  id            String   @id @default(cuid())
  transactionId String
  points        Int
  reason        String
  createdById   String?
  createdAt     DateTime @default(now())

  transaction PointTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model Voucher {
  id               String              @id @default(cuid())
  organizationId   String
  /// null = mọi chi nhánh
  branchId         String?
  code             String
  title            String
  description      String?
  discountType     VoucherDiscountType @default(PERCENT)
  discountValue    Float               @default(0)
  /// Số điểm khách phải đổi để lấy voucher. 0 = phát tặng, không cần điểm.
  pointsCost       Int                 @default(0)
  /// null = phát không giới hạn
  quantity         Int?
  issuedCount      Int                 @default(0)
  perCustomerLimit Int                 @default(1)
  requiredTierId   String?
  /// Tự phát vào dịp sinh nhật khách.
  autoBirthday     Boolean             @default(false)
  status           VoucherStatus       @default(DRAFT)
  startsAt         DateTime?
  expiresAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  issued       IssuedVoucher[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model IssuedVoucher {
  id             String              @id @default(cuid())
  organizationId String
  voucherId      String
  customerId     String
  /// Mã riêng của từng bản đã phát — đây là mã khách đưa ra khi thanh toán.
  code           String              @unique
  status         IssuedVoucherStatus @default(ISSUED)
  issuedAt       DateTime            @default(now())
  redeemedAt     DateTime?
  expiresAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  voucher      Voucher      @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([customerId])
}

model Reward {
  id             String       @id @default(cuid())
  organizationId String
  branchId       String?
  name           String
  description    String?
  imageUrl       String?
  pointsCost     Int
  /// null = không giới hạn tồn
  stock          Int?
  redeemLimit    Int?
  status         RewardStatus @default(ACTIVE)
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  redemptions  RewardRedemption[]

  @@index([organizationId, status])
}

model RewardRedemption {
  id             String           @id @default(cuid())
  organizationId String
  rewardId       String
  customerId     String
  pointsSpent    Int
  status         RedemptionStatus @default(PENDING)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reward       Reward       @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
}

// ────────────────────────────────────────────────────────────
// LANDING PAGES
// ────────────────────────────────────────────────────────────

model LandingPage {
  id             String            @id @default(cuid())
  organizationId String
  title          String
  slug           String
  templateKey    String            @default("restaurant")
  status         LandingPageStatus @default(DRAFT)
  headline       String?
  subheadline    String?
  blocks         Json?
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
}

// ────────────────────────────────────────────────────────────
// LV SERVICE MARKETPLACE
// ────────────────────────────────────────────────────────────

model Service {
  id        String          @id @default(cuid())
  slug      String          @unique
  name      String
  nameDe    String?
  category  ServiceCategory
  summary   String
  summaryDe String?
  process   String[]
  leadTime  String?
  isActive  Boolean         @default(true)
  position  Int             @default(0)

  requests ServiceRequest[]
}

model ServiceRequest {
  id             String               @id @default(cuid())
  organizationId String
  serviceId      String
  requesterId    String?
  title          String
  brief          String
  budgetHint     String?
  status         ServiceRequestStatus @default(SUBMITTED)
  quoteCents     Int?
  currency       String               @default("EUR")
  dueDate        DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service                 @relation(fields: [serviceId], references: [id])
  requester    User?                   @relation("ServiceRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  messages     ServiceRequestMessage[]

  @@index([organizationId, status])
}

model ServiceRequestMessage {
  id               String   @id @default(cuid())
  serviceRequestId String
  authorId         String?
  body             String
  attachments      Json?
  createdAt        DateTime @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  author         User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([serviceRequestId, createdAt])
}

// ────────────────────────────────────────────────────────────
// BILLING / PLATFORM
// ────────────────────────────────────────────────────────────

model Plan {
  id             String   @id @default(cuid())
  key            PlanKey  @unique
  name           String
  description    String
  /// null = báo giá theo nhu cầu, không hiển thị giá cố định.
  monthlyCents   Int?
  currency       String   @default("EUR")
  maxBrands      Int      @default(1)
  maxChannels    Int      @default(2)
  maxUsers       Int      @default(3)
  aiCreditsMonth Int      @default(100)
  features       String[]
  position       Int      @default(0)

  subscriptions Subscription[]
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @unique
  planId         String
  status         SubscriptionStatus @default(TRIALING)
  startedAt      DateTime           @default(now())
  trialEndsAt    DateTime?
  renewsAt       DateTime?
  cancelledAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
}

model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  metric         String
  quantity       Int      @default(0)
  periodStart    DateTime
  periodEnd      DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, periodStart])
}

// ────────────────────────────────────────────────────────────
// AI
// ────────────────────────────────────────────────────────────

model AiPromptTemplate {
  id           String     @id @default(cuid())
  key          String
  version      Int        @default(1)
  taskType     AiTaskType
  systemPrompt String
  description  String?
  model        String     @default("claude-sonnet-5")
  maxTokens    Int        @default(2048)
  temperature  Float      @default(0.7)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  generations AiGeneration[]

  @@unique([key, version])
}

model AiGeneration {
  id             String             @id @default(cuid())
  organizationId String
  userId         String?
  templateId     String?
  taskType       AiTaskType
  model          String
  promptKey      String?
  promptVersion  Int?
  input          Json
  output         Json?
  status         AiGenerationStatus @default(PENDING)
  error          String?
  inputTokens    Int                @default(0)
  outputTokens   Int                @default(0)
  costMicroCents Int                @default(0)
  latencyMs      Int                @default(0)
  createdAt      DateTime           @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  template     AiPromptTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([taskType, status])
}

model StrategyDocument {
  id             String    @id @default(cuid())
  organizationId String
  version        Int       @default(1)
  title          String
  brandSummary   String?
  personas       Json?
  goals          Json?
  contentPillars Json?
  monthlyPlan    Json?
  channels       Json?
  seasonal       Json?
  localIdeas     Json?
  competitors    Json?
  campaignIdeas  Json?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, version])
}

// ────────────────────────────────────────────────────────────
// PLATFORM SUPPORT
// ────────────────────────────────────────────────────────────

model Notification {
  id             String           @id @default(cuid())
  organizationId String?
  userId         String
  kind           NotificationKind @default(SYSTEM)
  title          String
  body           String?
  href           String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  entity         String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
}

model SupportTicket {
  id             String       @id @default(cuid())
  organizationId String?
  authorId       String?
  subject        String
  body           String
  status         TicketStatus @default(OPEN)
  priority       Priority     @default(NORMAL)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User?         @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, priority])
}
